# 复制为 .env 后填写本地值；本文件和 Expect 均按字面量解析，不使用 source/eval。
# 支持 KEY=VALUE、单引号或双引号包裹整值；不展开 $、反引号或转义字符。
JUMP_HOST=
JUMP_PORT=2222
JUMP_USER=
JUMP_PASSWORD=
MFA_SECRET=
APP_USER=
APP_GROUP=
LOG_DIR=
OATH_TOOL=/opt/homebrew/bin/oathtool
TARGET_HOST=

# 模型完整原生配置集中保存在此 JSON 字符串中；apiKey 使用环境变量名引用。
MAGPIE_API_KEY=
PI_MODELS_JSON='{"providers":{}}'
# 修改后运行 python3 -I scripts/export_models.py，生成被 Git 忽略的 docs/models.json。
# 安全检查登录配置：expect docs/login_bastion.exp --check，不生成 OTP、不连接 SSH。
