{
  "name": "finch",
  "version": "0.1.0",
  "description": "只读的 Java / Spring Boot 故障诊断 CLI：日志、源码与可检索故障经验",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "finch": "dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/src/",
    "assets/",
    "templates/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "pack:check": "npm run build && npm pack --dry-run --json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
