# Finch 连接配置模板。复制到 ~/.config/finch/.env 并填写。
# 该文件由用户手动维护，程序不会写入。
# 解析为字面量 KEY=VALUE，不执行 source、变量展开或命令替换。

JUMP_USER=
JUMP_PASSWORD=
MFA_SECRET=

# 固定环境默认值，按需修改。
APP_GROUP=appgroup
APP_USER=app
LOG_DIR=~/sxpservice/logs/

# 外部程序默认从 PATH 查找；如需覆盖，可在 shell 中设置：
#   EXPECT_PATH / OATH_TOOL
# 登录脚本由 finch 自动生成，无需指定 LOGIN_SCRIPT。
#
# 目标机由 /trace 决定：优先从日志记录头提取，其次最近使用，最后手输。
