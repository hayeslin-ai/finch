# Finch 连接配置模板。复制到 ~/.config/finch/.env 并填写。
# 该文件由用户手动维护，程序不会写入。
# 解析为字面量 KEY=VALUE，不执行 source、变量展开或命令替换。

JUMP_USER=
JUMP_PASSWORD=
MFA_SECRET=

# 固定环境默认值，按需修改。
APP_GROUP=appgroup
APP_USER=app
LOG_DIR=~/sxpservice/logs/

# 外部程序路径从环境变量读取，不写入本文件：
#   EXPECT_PATH / LOGIN_SCRIPT / OATH_TOOL
#
# 模型定义在 models.json，当前模型选择在 settings.json。
# 目标机由 /trace 决定：优先从日志记录头提取，其次最近使用，最后手输。
