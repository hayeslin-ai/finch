# Finch 本地配置模板。
# 复制到 ~/.config/finch/.env 并填写；该文件不得提交到仓库。
# 解析为字面量 KEY=VALUE，不执行 source、变量展开或命令替换。

# 诊断范围（仓库根与服务标识）由启动目录自动推导，无需配置。

# —— 登录程序（仅远程功能需要）——
EXPECT_PATH=
LOGIN_SCRIPT=
OATH_TOOL=

# —— 堡垒机与目标 ——
# 堡垒机地址和端口由程序内置，不在此配置。
JUMP_USER=
JUMP_PASSWORD=
MFA_SECRET=
APP_GROUP=
APP_USER=
LOG_DIR=
# 默认目标机，必须是 22.50.0.0/16 或 10.80.0.0/16 内的 IPv4。
TARGET_HOST=

# —— 当前模型 ——
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
